NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=KEEP_THIS_SECRET_ON_SERVER

# Owner email yang diizinkan masuk ke dashboard
OWNER_EMAIL=alifrizkyefendi@gmail.com

# Midtrans Sandbox/Production credentials
MIDTRANS_SERVER_KEY=YOUR_MIDTRANS_SERVER_KEY
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=YOUR_MIDTRANS_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PIN bukan disimpan di source code. Buat akun Owner melalui Supabase Auth
# dan gunakan PIN/password kuat sebagai password login.